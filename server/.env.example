# ============ 后端环境变量模板 ============
# 复制为 .env 并按需修改；生产环境（Railway/Vercel）在控制台直接配置，不需要 .env 文件

# 服务端口（Railway 会自动注入 PORT，本地默认 3001）
PORT=3001

# 数据目录（SQLite 文件所在）
# 本地：server/data；Railway 用 volume：/data
DATA_DIR=

# 上传目录（视频与缩略图存储）
# 本地：server/uploads；Railway 用 volume：/uploads
UPLOADS_DIR=

# 允许的前端来源（CORS），多个用逗号分隔
# 本地开发留空表示允许全部；生产填 Vercel 域名，如 https://your-app.vercel.app
CORS_ORIGIN=
